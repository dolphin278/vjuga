{
  "name": "@dolphin278/vjuga",
  "version": "5.0.0",
  "packageManager": "npm@10.5.0",
  "license": "MIT",
  "exports": {
    "./*": "./src/*"
  },
  "type": "module",
  "scripts": {
    "clean": "tsc --build --clean",
    "test": "node --test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "oxlint ./src",
    "coverage": "c8 --src=src --all --report --reporter html --reporter text --per-file --skip-full -- node --test",
    "prepare": "npm run clean && tsc --declaration --emitDeclarationOnly --project tsconfig.json && npm run lint && prettier --check src && npm run coverage",
    "format": "npm run lint --fix && prettier --write src",
    "postpack": "npm run clean"
  },
  "devDependencies": {
    "@types/node": "^20.11.15",
    "c8": "^9.1.0",
    "oxlint": "^0.4.0",
    "prettier": "^3.3.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

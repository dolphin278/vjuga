{
  "name": "@dolphin278/vjuga",
  "version": "5.0.0",
  "packageManager": "npm@10.5.0",
  "license": "MIT",
  "exports": {
    "./*": "./src/*"
  },
  "type": "module",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "lint": "oxlint ./src",
    "coverage": "c8 --src=src --all --report --reporter html --reporter text --per-file --skip-full -- node --test ",
    "ci": "npm run lint && prettier --check src && npm run typecheck && npm run coverage",
    "format": "npm run lint --fix && prettier --write src"
  },
  "devDependencies": {
    "@types/node": "^20.11.15",
    "c8": "^7.12.0",
    "oxlint": "^0.4.0",
    "prettier": "^2.8.3",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

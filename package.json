{
  "name": "@dolphin278/vjuga",
  "version": "8.0.0",
  "packageManager": "npm@10.5.0",
  "license": "MIT",
  "exports": {
    "./*.js": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "type": "module",
  "scripts": {
    "clean": "tsc --build --clean",
    "test": "tsc --project tsconfig.test.json && node --test 'src/tests/*.test.js' 'src/tests/schema/*.test.js'",
    "test:fuzz": "tsc --project tsconfig.test.json && node --test 'src/tests/fuzz/*.test.js' 'src/tests/fuzz/schema/*.test.js'",
    "test:bun": "bash -c 'bun test $(ls src/tests/*.test.js) $(ls src/tests/schema/*.test.js)'",
    "test:fuzz:bun": "bash -c 'bun test $(ls src/tests/fuzz/*.test.js) $(ls src/tests/fuzz/schema/*.test.js)'",
    "test:all": "bash -c 'npm run test & P1=$!; npm run test:bun & P2=$!; wait $P1; R1=$?; wait $P2; R2=$?; exit $((R1|R2))'",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "oxlint ./src",
    "lint:fix": "oxlint --fix ./src",
    "coverage": "tsc --project tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude='src/benchmarks/**' --test-coverage-exclude='src/tests/fixtures/**' --test-coverage-exclude='src/**/*.ts' --test 'src/tests/*.test.js' 'src/tests/schema/*.test.js'",
    "coverage:bun": "bash -c 'bun test src/tests/*.test.js src/tests/schema/*.test.js'",
    "coverage:all": "bash -c 'npm run coverage & P1=$!; npm run coverage:bun & P2=$!; wait $P1; R1=$?; wait $P2; R2=$?; exit $((R1|R2))'",
    "lint:docs": "node scripts/lint-docs.js",
    "prepare": "npm run clean && tsc --project tsconfig.json && npm run lint && oxfmt --check 'src/**/*.ts' '!src/**/*.d.ts' && npm run coverage:all && npm run test:fuzz && npm run lint:docs",
    "format": "oxfmt 'src/**/*.ts' '!src/**/*.d.ts'",
    "bench:bun": "bun src/benchmarks/all.bench.ts",
    "bench:node": "node --experimental-strip-types src/benchmarks/all.bench.ts",
    "verify:v8": "node --allow-natives-syntax --expose-gc --experimental-strip-types src/benchmarks/all.bench.ts",
    "profile:cpu:node": "node --prof --expose-gc --experimental-strip-types",
    "profile:heap:node": "node --heap-prof --expose-gc --experimental-strip-types",
    "profile:cpu:bun": "bun --cpu-prof --cpu-prof-md",
    "profile:heap:bun": "bun --heap-prof --heap-prof-md",
    "profile:mem:bun": "MIMALLOC_SHOW_STATS=1 bun",
    "postpack": "npm run clean"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bloomfilter": "^1.1.0",
    "fast-json-stringify": "^6.3.0",
    "fastbitset": "^0.5.2",
    "mitata": "^0.1.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "sorted-btree": "^2.1.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src/*.js",
    "src/*.d.ts",
    "src/schema/*.js",
    "src/schema/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
